using System.Collections.Generic;

namespace LHPets;

public class Banco
{
    // Atributo estático contendo a lista de clientes
    private static List<Cliente> listaClientes = new List<Cliente>()
    {
        new Cliente() { Nome = "Ricardo Silva", CpfCnpj = "123.456.789-00", Email = "ricardo@email.com" },
        new Cliente() { Nome = "Clínica Vet LH", CpfCnpj = "12.345.678/0001-99", Email = "contato@vetlh.com" },
        new Cliente() { Nome = "Ana Costa", CpfCnpj = "987.654.321-11", Email = "ana.costa@email.com" }
    };

    // Método para expor a lista para a nossa rota no Program.cs
    public List<Cliente> GetListaClientes()
    {
        return listaClientes;
    }

    // Método formatado em String/HTML para exibir na página web de forma limpa
    public string GetListaClientesEmTexto()
    {
        string conteudo = "<h2>Lista de Clientes - LH Pets</h2><ul>";
        foreach (var cliente in listaClientes)
        {
            conteudo += $"<li><strong>Nome:</strong> {cliente.Nome} | <strong>CPF/CNPJ:</strong> {cliente.CpfCnpj} | <strong>Email:</strong> {cliente.Email}</li>";
        }
        conteudo += "</ul>";
        return conteudo;
    }
}
