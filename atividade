DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rust Engenharia - Fluxo de Mão de Obra</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <style>
       /* ===========================
   RESET
===========================*/

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Segoe UI",Roboto,Arial,sans-serif;
}

body{
    display:flex;
    height:100vh;
    overflow:hidden;
    background:#eef2f7;
    color:#2c3e50;
}

/* ===========================
SIDEBAR
===========================*/

.sidebar{

    width:80px;
    background:linear-gradient(180deg,#0f172a,#1e293b);

    color:white;

    display:flex;
    flex-direction:column;

    transition:.35s;

    box-shadow:
    8px 0 25px rgba(0,0,0,.15);

}

.sidebar.expanded{
    width:260px;
}

.sidebar-header{

    padding:18px;

    border-bottom:1px solid rgba(255,255,255,.08);

    cursor:pointer;

    display:flex;

    align-items:center;

    gap:15px;
}

.sidebar-title{

    font-size:18px;

    font-weight:700;

    opacity:0;

    transition:.3s;
}

.sidebar.expanded .sidebar-title{

    opacity:1;
}

.menu-btn{

    background:none;

    border:none;

    color:#cbd5e1;

    display:flex;

    align-items:center;

    gap:15px;

    padding:15px 18px;

    cursor:pointer;

    transition:.25s;

    border-left:4px solid transparent;

}

.menu-btn:hover{

    background:#334155;

    color:white;

    border-left:4px solid #38bdf8;

}

.menu-btn.active{

    background:#2563eb;

    color:white;

    border-left:4px solid white;

}

.icon{

    font-size:20px;

    width:24px;

    text-align:center;
}

.text{

    opacity:0;

    transition:.3s;
}

.sidebar.expanded .text{

    opacity:1;
}

/* ===========================
CONTEÚDO
===========================*/

.content{

    flex:1;

    overflow:auto;

    padding:30px;

    background:#f5f7fb;

}

h3{

    font-size:28px;

    margin-bottom:25px;

    color:#0f172a;

}

/* ===========================
CARDS
===========================*/

.card{

    background:white;

    border-radius:18px;

    border:none;

    padding:22px;

    margin-bottom:20px;

    box-shadow:

    0 10px 30px rgba(0,0,0,.08);

    transition:.25s;

}

.card:hover{

    transform:translateY(-4px);

    box-shadow:

    0 18px 40px rgba(0,0,0,.12);

}

/* ===========================
BOTÕES
===========================*/

button{

    border:none;

    border-radius:10px;

    padding:12px 20px;

    background:#2563eb;

    color:white;

    cursor:pointer;

    font-weight:600;

    transition:.25s;

}

button:hover{

    background:#1d4ed8;

    transform:translateY(-2px);

}

.edit-btn{

    background:#f59e0b;
}

.edit-btn:hover{

    background:#d97706;
}

.del-btn{

    background:#ef4444;
}

.del-btn:hover{

    background:#dc2626;
}

/* ===========================
INPUTS
===========================*/

input,
select{

    border:1px solid #dbe4ee;

    border-radius:10px;

    padding:12px;

    background:white;

    transition:.25s;

    font-size:14px;

}

input:focus,
select:focus{

    outline:none;

    border-color:#2563eb;

    box-shadow:0 0 0 4px rgba(37,99,235,.15);

}

/* ===========================
FORM
===========================*/

.form-group{

    display:flex;

    gap:15px;

    flex-wrap:wrap;

    margin-bottom:20px;

}

/* ===========================
TABELAS
===========================*/

table{

    width:100%;

    border-collapse:collapse;

    overflow:hidden;

    border-radius:14px;

}

thead{

    background:#1e293b;

    color:white;

}

th{

    padding:15px;

    font-size:14px;

    text-align:left;

}

td{

    padding:14px;

    border-bottom:1px solid #edf2f7;

}

tbody tr{

    transition:.2s;
}

tbody tr:hover{

    background:#f8fafc;

}

/* ===========================
BADGES
===========================*/

.badge{

    padding:6px 10px;

    border-radius:30px;

    font-size:12px;

    font-weight:bold;

}

.active-bg{

    background:#dcfce7;

    color:#15803d;

}

.ended-bg{

    background:#fee2e2;

    color:#b91c1c;

}

.obs-bg{

    background:#e2e8f0;

    color:#475569;

}

/* ===========================
ABAS
===========================*/

.appsheet-tabs{

    display:flex;

    gap:10px;

    margin-bottom:20px;

    border:none;

}

.tab-btn{

    background:white;

    color:#475569;

    border-radius:10px;

    padding:12px 18px;

    transition:.25s;

}

.tab-btn:hover{

    background:#e2e8f0;

}

.tab-btn.active{

    background:#2563eb;

    color:white;

}

/* ===========================
LISTAS
===========================*/

.list-item{

    display:flex;

    justify-content:space-between;

    align-items:center;

    background:white;

    border-radius:12px;

    padding:15px;

    margin-bottom:10px;

    box-shadow:0 3px 10px rgba(0,0,0,.05);

}

.list-actions{

    display:flex;

    gap:8px;

}

/* ===========================
MODAL
===========================*/

.modal{

    background:rgba(15,23,42,.65);

    backdrop-filter:blur(6px);

}

.modal-content{

    border-radius:18px;

    border:none;

    box-shadow:0 25px 50px rgba(0,0,0,.25);

}

/* ===========================
SCROLL
===========================*/

::-webkit-scrollbar{

    width:10px;

}

::-webkit-scrollbar-thumb{

    background:#94a3b8;

    border-radius:20px;

}

::-webkit-scrollbar-track{

    background:#e2e8f0;

}
    </style>
</head>
<body>

    <div class="sidebar" id="sidebar">
        <div class="sidebar-header" onclick="toggleSidebar()">
            <div class="menu-toggle">☰</div>
            <div class="sidebar-title">Rust Engenharia</div>
        </div>
        <button class="menu-btn active" id="btn-dash" onclick="mudarTela('dash')">
            <span class="icon">📊</span>
            <span class="text">Dash Painel</span>
        </button>
        <button class="menu-btn" id="btn-projetos" onclick="mudarTela('projetos')">
            <span class="icon">🏗️</span>
            <span class="text">Projetos</span>
        </button>
        <button class="menu-btn" id="btn-funcionarios" onclick="mudarTela('funcionarios')">
            <span class="icon">👤</span>
            <span class="text">Funcionários</span>
        </button>
    </div>

    <div class="content">
        
        <div id="tela-dash" class="page active">
            <h3>📊 Dash Painel de Contratação <small style="font-size:12px; color:#64748b; font-weight:normal;">(Arraste pelo topo ou redimensione pelo canto inferior direito)</small></h3>
            
            <div class="dashboard-grid" id="dash-sortable-container">
                
                <div class="card" id="card-filtro-ciclo" style="height: 110px;">
                    <div class="card-drag-handle">⋮⋮</div>
                    <div class="form-group" style="margin-bottom: 0; padding-right: 20px;">
                        <label style="font-weight: bold; color: #475569;">Data de Início do Ciclo:</label>
                        <input type="date" id="dataCicloInput" style="max-width: 200px;">
                        <button onclick="atualizarDataCiclo()">🔄 Atualizar Ciclo de 12 Semanas</button>
                    </div>
                </div>

                <div class="card" id="card-grafico-semanas">
                    <div class="card-drag-handle">⋮⋮</div>
                    <div class="chart-container">
                        <canvas id="graficoSemanas"></canvas>
                    </div>
                </div>

                <div class="card" id="card-tabela-ativas" style="height: 300px;">
                    <div class="card-drag-handle">⋮⋮</div>
                    <h4 style="color: #0f172a; margin-bottom: 10px;">🏗️ Obras Ativas no Período</h4>
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Nº</th>
                                    <th>Obra</th>
                                    <th>Início</th>
                                    <th>Fim</th>
                                    <th>Demandas Cadastradas</th>
                                </tr>
                            </thead>
                            <tbody id="tabela-obras-ativas-dash"></tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

        <div id="tela-projetos" class="page">
            <h3>🏗️ Gerenciamento de Projetos / Obras</h3>
            
            <div class="card" style="resize:none; height:auto;">
                <h4>➕ Adicionar Nova Obra</h4>
                <div class="form-group" style="margin-top: 15px;">
                    <input type="number" id="projNumero" placeholder="Nº da Obra">
                    <input type="text" id="projObra" placeholder="Nome da Obra (Ex: BRACELL)">
                    <input type="date" id="projInicio">
                    <input type="date" id="projFim">
                </div>
                <div id="campos-demandas-dinamicas"></div>
                <button onclick="adicionarObra()" style="margin-top: 15px;">Salvar Obra</button>
            </div>

            <div class="appsheet-tabs">
                <button class="tab-btn active" id="tab-todas" onclick="filtrarAbasObras('todas')">Todas as Obras</button>
                <button class="tab-btn" id="tab-ativas" onclick="filtrarAbasObras('ativas')">Ativas 🟢</button>
                <button class="tab-btn" id="tab-concluidas" onclick="filtrarAbasObras('concluidas')">Concluídas 🔴</button>
                <button class="tab-btn" id="tab-obsoletas" onclick="filtrarAbasObras('obsoletas')">Obsoletas ⚪</button>
            </div>

            <div class="card" style="margin-top: 0; border-top-left-radius: 0; border-top-right-radius: 0; resize:none; height:auto;">
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Nº</th>
                                <th>Obra</th>
                                <th>Início</th>
                                <th>Fim</th>
                                <th>Status</th>
                                <th>Demandas por Cargo</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody id="tabela-obras-corpo"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="tela-funcionarios" class="page">
            <h3>👤 Cadastro Simplificado de Funcionários</h3>
            <div class="card" style="resize:none; height:auto;">
                <div class="form-group">
                    <input type="text" id="funcNome" placeholder="Nome do Funcionário">
                    <input type="text" id="funcCargo" placeholder="Cargo / Função (Livre)" oninput="this.value = this.value.toUpperCase()">
                    <select id="funcTipo">
                        <option value="DIRETA">Mão de Obra Direta (MOD)</option>
                        <option value="INDIRETA">Mão de Obra Indireta (MOI)</option>
                    </select>
                    <button onclick="adicionarFuncionario()">Adicionar</button>
                </div>
                <div id="lista-funcionarios-corpo"></div>
            </div>
        </div>

    </div>

    <div id="modalFunc" class="modal">
        <div class="modal-content">
            <h4>✏️ Editar Funcionário</h4>
            <input type="hidden" id="modalFuncIdx">
            <div class="modal-form-group">
                <div><label>Nome do Funcionário</label><input type="text" id="modalFuncNome"></div>
                <div><label>Cargo / Função</label><input type="text" id="modalFuncCargo" oninput="this.value = this.value.toUpperCase()"></div>
                <div>
                    <label>Tipo de Mão de Obra</label>
                    <select id="modalFuncTipo">
                        <option value="DIRETA">Mão de Obra Direta (MOD)</option>
                        <option value="INDIRETA">Mão de Obra Indireta (MOI)</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button style="background-color: #64748b;" onclick="fecharModal('modalFunc')">Cancelar</button>
                <button onclick="salvarModalFunc()">Salvar Alterações</button>
            </div>
        </div>
    </div>

    <div id="modalObra" class="modal">
        <div class="modal-content" style="width: 600px;">
            <h4>✏️ Editar Obra / Projeto</h4>
            <input type="hidden" id="modalObraIdx">
            <div class="modal-form-group">
                <div style="flex-direction: row; gap: 10px;">
                    <div style="flex: 1;"><label>Nº da Obra</label><input type="number" id="modalObraNumero"></div>
                    <div style="flex: 2;"><label>Nome da Obra</label><input type="text" id="modalObraNome"></div>
                </div>
                <div style="flex-direction: row; gap: 10px;">
                    <div style="flex: 1;"><label>Data de Início</label><input type="date" id="modalObraInicio"></div>
                    <div style="flex: 1;"><label>Data de Fim</label><input type="date" id="modalObraFim"></div>
                </div>
                <div id="modal-campos-demandas-dinamicas" style="margin-top: 10px; max-height: 200px; overflow-y: auto; padding-right: 5px;"></div>
            </div>
            <div class="modal-footer">
                <button style="background-color: #64748b;" onclick="fecharModal('modalObra')">Cancelar</button>
                <button onclick="salvarModalObra()">Salvar Alterações</button>
            </div>
        </div>
    </div>

    <script>
        const anoAtual = new Date().getFullYear();

        let funcionarios = [
            { Nome: "Luiz Fernando", Cargo: "ENCARREGADO", Tipo: "DIRETA" },
            { Nome: "Eden Oliveira", Cargo: "AJUDANTE", Tipo: "DIRETA" },
            { Nome: "Edmar Cecilio", Cargo: "AJUDANTE", Tipo: "DIRETA" },
            { Nome: "Carlos Alberto", Cargo: "REVESTIDOR", Tipo: "DIRETA" },
            { Nome: "João Silva", Cargo: "REVESTIDOR", Tipo: "DIRETA" }
        ];

        // Definindo as obras com o ano corrente dinamicamente para evitar tabelas vazias
        let projetos = [
            { Numero: 143, Obra: "ALUNORTE", Data_Inicio: `${anoAtual}-07-20`, Data_Fim: `${anoAtual}-12-23`, Demandas: { "ENCARREGADO": 1, "REVESTIDOR": 8, "AJUDANTE": 0 } },
            { Numero: 393, Obra: "FORTES", Data_Inicio: `${anoAtual}-04-13`, Data_Fim: `${anoAtual}-11-16`, Demandas: { "ENCARREGADO": 2, "REVESTIDOR": 16, "AJUDANTE": 5 } },
            { Numero: 171, Obra: "CETREL", Data_Inicio: `${anoAtual}-06-16`, Data_Fim: `${anoAtual}-07-31`, Demandas: { "ENCARREGADO": 1, "REVESTIDOR": 6, "AJUDANTE": 0 } },
            { Numero: '011', Obra: "SOWITEC/VOPAK", Data_Inicio: `${anoAtual}-05-04`, Data_Fim: `${anoAtual}-07-31`, Demandas: { "ENCARREGADO": 1, "REVESTIDOR": 5, "AJUDANTE": 0 } },
            { Numero: 178, Obra: "PROQ. CANDEIAS", Data_Inicio: "", Data_Fim: "", Demandas: {} },
            { Numero: 279, Obra: "PROQ. ACRINOR", Data_Inicio: "", Data_Fim: "", Demandas: {} },
            { Numero: 246, Obra: "BRACELL", Data_Inicio: `${anoAtual}-03-30`, Data_Fim: `${anoAtual}-05-17`, Demandas: { "REVESTIDOR": 4 } }
        ];

        let dataInicioCiclo = new Date(`${anoAtual}-06-15T00:00:00`);
        document.getElementById('dataCicloInput').value = `${anoAtual}-06-15`;

        let meuGrafico = null;
        let filtroProjetoAtual = "todas"; 

        function inicializarPainelDinamico() {
            let painel = document.getElementById('dash-sortable-container');
            Sortable.create(painel, {
                handle: '.card-drag-handle',
                animation: 200,
                ghostClass: 'sortable-ghost',
                onEnd: function() { if(meuGrafico) meuGrafico.resize(); }
            });

            const observadorTratador = new ResizeObserver(() => {
                if (meuGrafico) meuGrafico.resize();
            });
            observadorTratador.observe(document.getElementById('card-grafico-semanas'));
        }

        function toggleSidebar() { document.getElementById('sidebar').classList.toggle('expanded'); }

        function mudarTela(id) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.menu-btn').forEach(b => b.classList.remove('active'));
            if(id === 'dash') document.getElementById('tela-dash').classList.add('active');
            if(id === 'projetos') document.getElementById('tela-projetos').classList.add('active');
            if(id === 'funcionarios') document.getElementById('tela-funcionarios').classList.add('active');
            document.getElementById(`btn-${id}`).classList.add('active');
            renderizarTudo();
        }

        function filtrarAbasObras(tipo) {
            filtroProjetoAtual = tipo;
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(`tab-${tipo}`).classList.add('active');
            renderizarTudo();
        }

        function obterCargos() { return [...new Set(funcionarios.map(f => f.Cargo))].sort(); }
        function abrirModal(id) { document.getElementById(id).style.display = 'flex'; }
        function fecharModal(id) { document.getElementById(id).style.display = 'none'; }

        function obterStatusObra(p) {
            if (!p.Data_Inicio || !p.Data_Fim) return "OBSOLETA";
            let hoje = new Date(); hoje.setHours(0,0,0,0);
            let p_ini = new Date(p.Data_Inicio + "T00:00:00");
            let p_fim = new Date(p.Data_Fim + "T00:00:00");
            if (p_fim < hoje) return "CONCLUÍDA";
            let inicioGrafico = new Date(dataInicioCiclo);
            let fimGrafico = new Date(dataInicioCiclo);
            fimGrafico.setDate(fimGrafico.getDate() + (12 * 7) - 1);
            if (p_fim >= hoje && (p_ini <= fimGrafico && p_fim >= inicioGrafico)) return "ATIVA";
            return "OBSOLETA";
        }

        function formatarDataBR(dataStr) {
            if(!dataStr) return "-";
            let partes = dataStr.split('-');
            if(partes.length !== 3) return dataStr;
            return `${partes[2]}/${partes[1]}/${partes[0]}`;
        }

        function calcularMatriz() {
            let matriz = []; let cargos = obterCargos();
            for (let i = 0; i < 12; i++) {
                let d_ini = new Date(dataInicioCiclo); d_ini.setDate(d_ini.getDate() + (i * 7));
                let d_fim = new Date(d_ini); d_fim.setDate(d_fim.getDate() + 6);
                let diaIni = String(d_ini.getDate()).padStart(2, '0'); let mesIni = String(d_ini.getMonth() + 1).padStart(2, '0');
                let diaFim = String(d_fim.getDate()).padStart(2, '0'); let mesFim = String(d_fim.getMonth() + 1).padStart(2, '0');
                let nomeSemana = `Semana ${String(i+1).padStart(2, '0')} (de ${diaIni}/${mesIni} à ${diaFim}/${mesFim})`;
                let total_ativo_mod = funcionarios.filter(f => f.Tipo === "DIRETA").length;
                let capacidadeCargo = {}; cargos.forEach(c => capacidadeCargo[c] = 0); funcionarios.forEach(f => capacidadeCargo[f.Cargo]++);
                let demandaCargo = {}; cargos.forEach(c => demandaCargo[c] = 0);
                projetos.forEach(p => {
                    if (!p.Data_Inicio || !p.Data_Fim) return;
                    let p_ini = new Date(p.Data_Inicio + "T00:00:00"); let p_fim = new Date(p.Data_Fim + "T00:00:00");
                    if (!(p_fim < d_ini || p_ini > d_fim)) cargos.forEach(c => demandaCargo[c] += p.Demandas[c] || 0);
                });
                let total_utilizado = 0; let total_disponivel = 0; let total_faltando = 0;
                let listaCargosFaltantes = []; let listaCargosDisponiveis = [];
                cargos.forEach(c => {
                    let cap = capacidadeCargo[c] || 0; let dem = demandaCargo[c] || 0;
                    let funcExemplo = funcionarios.find(f => f.Cargo === c); let eDireta = funcExemplo ? funcExemplo.Tipo === "DIRETA" : true;
                    if (cap >= dem) {
                        if (eDireta) { total_utilizado += dem; let sobra = (cap - dem); total_disponivel += sobra; if (sobra > 0) listaCargosDisponiveis.push(`${c}: ${sobra}`); }
                    } else {
                        if (eDireta) total_utilizado += cap;
                        let faltam = (dem - cap); total_faltando += faltam; listaCargosFaltantes.push(`${c}: ${faltam}`);
                    }
                });
                matriz.push({ Semana: nomeSemana, Ativo: total_ativo_mod, Utilizado: total_utilizado, Disponivel: total_disponivel, Faltando: total_faltando > 0 ? -total_faltando : 0, FaltandoDetalhe: listaCargosFaltantes.join(' | '), DisponivelDetalhe: listaCargosDisponiveis.join(' | ') });
            }
            return matriz;
        }

        function renderizarTudo() {
            let matriz = calcularMatriz(); let cargos = obterCargos();
            let ctx = document.getElementById('graficoSemanas').getContext('2d');
            if (meuGrafico) meuGrafico.destroy();
            meuGrafico = new Chart(ctx, {
                type: 'bar', data: {
                    labels: matriz.map(m => m.Semana),
                    datasets: [
                        { label: 'Total Ativo MOD', data: matriz.map(m => m.Ativo), backgroundColor: '#1f77b4' },
                        { label: 'Total utilizado', data: matriz.map(m => m.Utilizado), backgroundColor: '#ff7f0e' },
                        { label: 'Disponível', data: matriz.map(m => m.Disponivel), backgroundColor: '#2ca02c', detalhes: matriz.map(m => m.DisponivelDetalhe) },
                        { label: 'FALTANDO FUNÇÃO', data: matriz.map(m => m.Faltando), backgroundColor: '#d62728', detalhes: matriz.map(m => m.FaltandoDetalhe) }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, scales: { x: { ticks: { maxRotation: 45, minRotation: 45 } } } }
            });

            let htmlObrasAtivasDash = "";
            projetos.forEach(p => {
                if (obterStatusObra(p) === "ATIVA") {
                    let stringDemandas = Object.entries(p.Demandas).filter(([k,v]) => v > 0).map(([k, v]) => `${k}: ${v}`).join(' | ');
                    htmlObrasAtivasDash += `<tr><td><b>${p.Numero || '-'}</b></td><td><span style="color:#2563eb; font-weight:bold;">${p.Obra}</span></td><td>${formatarDataBR(p.Data_Inicio)}</td><td>${formatarDataBR(p.Data_Fim)}</td><td><small>${stringDemandas || 'Nenhuma'}</small></td></tr>`;
                }
            });
            document.getElementById('tabela-obras-ativas-dash').innerHTML = htmlObrasAtivasDash || "<tr><td colspan='5' style='text-align:center; color:#94a3b8;'>Nenhuma obra ativa.</td></tr>";

            let htmlFunc = ""; funcionarios.forEach((f, idx) => {
                htmlFunc += `<div class="list-item"><span>👤 <b>${f.Nome}</b> — <small style="background:#e2e8f0; padding:2px 6px; border-radius:4px; font-weight:bold;">${f.Cargo}</small> [${f.Tipo}]</span><div class="list-actions"><button class="edit-btn" onclick="iniciarEdicaoFunc(${idx})">✏️</button><button class="del-btn" onclick="removerFuncionario(${idx})">❌</button></div></div>`;
            });
            document.getElementById('lista-funcionarios-corpo').innerHTML = htmlFunc;

            let htmlCampos = "<label style='font-weight:bold; display:block; margin-bottom:5px;'>Definir Mão de Obra Necessária:</label><div style='display:flex; gap:15px; flex-wrap:wrap;'>";
            cargos.forEach(c => { htmlCampos += `<div style="display:flex; align-items:center; gap:5px;"><label style="font-size:13px; font-weight:bold;">${c}:</label><input type="number" id="demanda_${c}" value="0" min="0" style="max-width:70px; padding:6px;"></div>`; });
            document.getElementById('campos-demandas-dinamicas').innerHTML = htmlCampos + "</div>";

            let htmlObras = ""; 
            projetos.forEach((p, idx) => {
                let status = obterStatusObra(p); 
                
                // Normalização absoluta contra acentos para evitar falhas de batimento de string
                let statusTratado = status.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
                
                if (filtroProjetoAtual !== "todas" && filtroProjetoAtual !== statusTratado) return;
                
                let statusBadge = `<span class="badge ${status === 'ATIVA' ? 'active-bg' : status === 'CONCLUÍDA' ? 'ended-bg' : 'obs-bg'}">${status}</span>`;
                let stringDemandas = Object.entries(p.Demandas).filter(([k,v]) => v > 0).map(([k, v]) => `${k}: ${v}`).join(' | ') || 'Nenhuma';
                htmlObras += `<tr><td><b>${p.Numero || '-'}</b></td><td><b>${p.Obra}</b></td><td>${formatarDataBR(p.Data_Inicio)}</td><td>${formatarDataBR(p.Data_Fim)}</td><td>${statusBadge}</td><td><small>${stringDemandas}</small></td><td><button class="edit-btn" onclick="iniciarEdicaoObra(${idx})">✏️</button><button class="del-btn" onclick="removerObra(${idx})">🗑️</button></td></tr>`;
            });
            document.getElementById('tabela-obras-corpo').innerHTML = htmlObras || "<tr><td colspan='7' style='text-align:center; color:#94a3b8;'>Nenhum registro encontrado nesta categoria.</td></tr>";
        }

        function adicionarFuncionario() {
            let nome = document.getElementById('funcNome').value; let cargo = document.getElementById('funcCargo').value; let tipo = document.getElementById('funcTipo').value;
            if (nome && cargo) { funcionarios.push({ Nome: nome, Cargo: cargo, Tipo: tipo }); document.getElementById('funcNome').value = ""; document.getElementById('funcCargo').value = ""; renderizarTudo(); }
        }
        function removerFuncionario(idx) { funcionarios.splice(idx, 1); renderizarTudo(); }
        
        function adicionarObra() {
            let numero = document.getElementById('projNumero').value || '-'; let obra = document.getElementById('projObra').value; let inicio = document.getElementById('projInicio').value; let fim = document.getElementById('projFim').value;
            if (obra) { 
                let demandas = {}; obterCargos().forEach(c => { let input = document.getElementById(`demanda_${c}`); demandas[c] = input ? parseInt(input.value) || 0 : 0; });
                projetos.push({ Numero: numero, Obra: obra, Data_Inicio: inicio, Data_Fim: fim, Demandas: demandas });
                document.getElementById('projNumero').value = ""; document.getElementById('projObra').value = ""; document.getElementById('projInicio').value = ""; document.getElementById('projFim').value = "";
                renderizarTudo();
            }
        }
        
        function iniciarEdicaoObra(idx) {
            let p = projetos[idx]; let cargos = obterCargos();
            document.getElementById('modalObraIdx').value = idx;
            document.getElementById('modalObraNumero').value = p.Numero || '';
            document.getElementById('modalObraNome').value = p.Obra;
            document.getElementById('modalObraInicio').value = p.Data_Inicio;
            document.getElementById('modalObraFim').value = p.Data_Fim;
            let htmlModalCampos = "<label style='font-weight:bold; display:block; margin-bottom:8px;'>Demandas de Mão de Obra:</label>";
            cargos.forEach(c => { htmlModalCampos += `<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;"><label style="font-size:14px;">${c}:</label><input type="number" id="modal_demanda_${c}" value="${p.Demandas[c] || 0}" min="0" style="max-width:100px; padding:5px;"></div>`; });
            document.getElementById('modal-campos-demandas-dinamicas').innerHTML = htmlModalCampos;
            abrirModal('modalObra');
        }

        function salvarModalObra() {
            let idx = document.getElementById('modalObraIdx').value;
            let numero = document.getElementById('modalObraNumero').value || '-';
            let obra = document.getElementById('modalObraNome').value;
            let inicio = document.getElementById('modalObraInicio').value;
            let fim = document.getElementById('modalObraFim').value;
            if(obra) {
                let demandas = {}; obterCargos().forEach(c => { let input = document.getElementById(`modal_demanda_${c}`); demandas[c] = input ? parseInt(input.value) || 0 : 0; });
                projetos[idx] = { Numero: numero, Obra: obra, Data_Inicio: inicio, Data_Fim: fim, Demandas: demandas };
                fecharModal('modalObra'); renderizarTudo();
            }
        }

        function removerObra(idx) { projetos.splice(idx, 1); renderizarTudo(); }
        function atualizarDataCiclo() { let novaData = document.getElementById('dataCicloInput').value; if (novaData) { dataInicioCiclo = new Date(novaData + "T00:00:00"); renderizarTudo(); } }

        window.onload = function() { renderizarTudo(); inicializarPainelDinamico(); };
    </script>
</body>
